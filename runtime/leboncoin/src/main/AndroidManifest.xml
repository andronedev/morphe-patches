<?xml version="1.0" encoding="utf-8"?>
<!--
  Ce manifeste ne sert qu'à construire le dex du runtime.
  Le runtime n'est jamais installé comme application : `classes.dex` est extrait de l'APK
  (tâche `extractRuntimeDex`) puis chargé par l'APK leboncoin patché.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="false"
        android:label="Morphe LBC Runtime" />

</manifest>
